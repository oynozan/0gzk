# Copy this file to `.env.local` and fill in values you want to override.
# Every variable here is OPTIONAL — defaults target 0G mainnet (chain id 16661).

# ---------- Network selection ----------

# Server-side network. "mainnet" or "testnet". Default: mainnet.
OG_NETWORK=mainnet

# Client-side mirror. Must match OG_NETWORK; inlined into the browser bundle
# at build time so explorer links (chainscan vs chainscan-galileo) point at
# the right chain. If unset, client defaults to mainnet.
NEXT_PUBLIC_OG_NETWORK=mainnet

# ---------- Endpoints (override the network defaults) ----------

# EVM RPC. Default: https://evmrpc.0g.ai (mainnet) / https://evmrpc-testnet.0g.ai (testnet).
# OG_RPC_URL=https://evmrpc.0g.ai

# 0G Storage indexer. Default: https://indexer-storage-turbo.0g.ai (mainnet) /
# https://indexer-storage-testnet-turbo.0g.ai (testnet).
# OG_INDEXER_URL=https://indexer-storage-turbo.0g.ai

# Block explorer base URL. Default: https://chainscan.0g.ai (mainnet) /
# https://chainscan-galileo.0g.ai (testnet). Override if you self-host an
# explorer or point at a fork.
# NEXT_PUBLIC_OG_EXPLORER=https://chainscan.0g.ai

# ---------- CircuitRegistry contract ----------

# Chain ID used to resolve the registry address from the SDK's built-in map.
# Default: 16661.
# OG_CHAIN_ID=16661

# Explicit address override. Set this if your installed @0gzk/sdk version
# doesn't have an address baked in for your chain id (e.g. fresh mainnet
# deploy on a stale SDK release). Mainnet address baked in:
#   0xCe9f0DF51abeC7B8cD751067c6D8d3db5E2bE64d
# OG_REGISTRY_ADDRESS=0xCe9f0DF51abeC7B8cD751067c6D8d3db5E2bE64d

# ---------- Local cache ----------

# Where the server caches fetched bundles between requests.
# Default: ~/.0gzk/bundles
# OGZK_CACHE_DIR=/var/cache/0gzk
