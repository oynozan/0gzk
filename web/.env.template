# Copy this file to `.env.local` and fill in values you want to override.
# Every variable here is OPTIONAL — defaults target 0G mainnet (chain id 16661).

# ---------- Network selection ----------

# Server-side network: 0g-mainnet | 0g-testnet | base | base-sepolia
# ("mainnet"/"testnet" still work as deprecated 0G aliases). Default: 0g-mainnet.
OGZK_NETWORK=0g-mainnet

# Client-side mirror. Must match OGZK_NETWORK; inlined into the browser bundle
# at build time so explorer links point at the right chain. If unset, client
# defaults to 0g-mainnet.
NEXT_PUBLIC_OGZK_NETWORK=0g-mainnet

# ---------- Endpoints (override the network defaults) ----------

# EVM RPC. Defaults come from the network preset (e.g. https://evmrpc.0g.ai
# for 0g-mainnet, https://sepolia.base.org for base-sepolia).
# OG_RPC_URL=https://evmrpc.0g.ai

# 0G Storage indexer (used for 0G-hosted bundles).
# Default: https://indexer-storage-turbo.0g.ai (0g-mainnet) /
# https://indexer-storage-testnet-turbo.0g.ai (0g-testnet).
# OG_INDEXER_URL=https://indexer-storage-turbo.0g.ai

# IPFS gateway (used for IPFS-hosted bundles, i.e. records whose metadataURI
# is ipfs://...). Default: https://ipfs.io
# OGZK_IPFS_GATEWAY=https://ipfs.io

# Block explorer base URL. Default comes from the network preset (chainscan
# for 0G, basescan for Base). Override if you self-host an explorer.
# NEXT_PUBLIC_OG_EXPLORER=https://chainscan.0g.ai

# ---------- CircuitRegistry contract ----------

# Chain ID used to resolve the registry address from the SDK's built-in map.
# Default: the network preset's chain id.
# OG_CHAIN_ID=16661

# Explicit address override. Set this if your installed @0gzk/sdk version
# doesn't have an address baked in for your chain id (e.g. fresh deploy on a
# stale SDK release). Mainnet address baked in:
#   0xCe9f0DF51abeC7B8cD751067c6D8d3db5E2bE64d
# OGZK_REGISTRY_ADDRESS=0xCe9f0DF51abeC7B8cD751067c6D8d3db5E2bE64d

# ---------- Local cache ----------

# Where the server caches fetched bundles between requests.
# Default: ~/.0gzk/bundles
# OGZK_CACHE_DIR=/var/cache/0gzk
