# Environment template for projects that embed @0gzk/sdk programmatically
# (Node services, Next.js API routes, web/, examples/, etc.).
#
# The @0gzk/cli binary does NOT read .env files. Configure the CLI with
# `0gzk config set <key> <value>` instead — values are stored in
# ~/.0gzk/config.json (mode 0600). See packages/cli/README.md.
#
# Generic OGZK_* names are preferred; the legacy OG_* names still work.

# Network selection: 0g-mainnet (default) | 0g-testnet | base | base-sepolia.
# "mainnet"/"testnet" remain as deprecated 0G aliases.
OGZK_NETWORK=0g-mainnet

# Required for any operation that costs gas (publishing, registering).
# 0x-prefixed 32-byte hex string. NEVER commit this file.
OGZK_PRIVATE_KEY=0xreplace_with_your_funded_key

# Storage backend for bundle uploads: 0g (default on 0G chains) | ipfs
# (default on Base chains). IPFS uploads need a pinFileToIPFS-compatible
# token (e.g. a Pinata JWT).
# OGZK_STORAGE=ipfs
# OGZK_IPFS_API_TOKEN=eyJ...
# OGZK_IPFS_GATEWAY=https://ipfs.io

# Endpoint overrides. Defaults come from the network preset
# (packages/sdk/src/networks.ts).
# OGZK_RPC_URL=https://evmrpc.0g.ai
# OG_INDEXER_URL=https://indexer-storage-turbo.0g.ai
# OGZK_REGISTRY_ADDRESS=0x...

# For 0G Galileo testnet (faucet: https://faucet.0g.ai):
# OGZK_NETWORK=0g-testnet
# For Base Sepolia (bundles pin to IPFS, registry tx needs Base Sepolia ETH):
# OGZK_NETWORK=base-sepolia
