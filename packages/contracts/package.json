{
  "name": "@0gzk/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Foundry project for the 0gzk circuit registry and Groth16 verifier interface",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "clean": "rimraf out cache broadcast",
    "deploy:mainnet": "forge script script/Deploy.s.sol:Deploy --rpc-url mainnet --broadcast",
    "deploy:galileo": "forge script script/Deploy.s.sol:Deploy --rpc-url galileo --broadcast",
    "deploy:base": "forge script script/Deploy.s.sol:Deploy --rpc-url base --broadcast",
    "deploy:base-sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url base-sepolia --broadcast",
    "deploy:base-sepolia:verify": "forge script script/Deploy.s.sol:Deploy --rpc-url base-sepolia --broadcast --verify"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
