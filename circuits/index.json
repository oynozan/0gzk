      "inputs": {
        "lat": {
          "type": "uint",
          "visibility": "private",
          "description": "Encoded latitude (round((lat_deg + 90) * 1e6))"
        },
        "lng": {
          "type": "uint",
          "visibility": "private",
          "description": "Encoded longitude (round((lng_deg + 180) * 1e6))"
