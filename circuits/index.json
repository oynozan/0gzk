      "curve": "bn128",
      "inputs": {
        "subject": {
          "type": "field",
          "visibility": "private",
          "description": "Holder identity that the issuer signed off on"
        },
        "claim": {
          "type": "field",
          "visibility": "public",
          "description": "Public statement the issuer attested to (e.g. Poseidon(\"isAdult\"))"
        },
        "issuerAx": {
          "type": "field",
          "visibility": "public",
          "description": "Baby Jubjub x coordinate of the issuer's public key"
        },
        "issuerAy": {
          "type": "field",
          "visibility": "public",
          "description": "Baby Jubjub y coordinate of the issuer's public key"
        },
        "sigS": {
