      "description": "Verifies an issuer's Baby Jubjub EdDSA signature over Poseidon(subject, claim) without revealing the subject; emits a per-context nullifier",
      "tags": [
        "credential",
        "signature",
        "eddsa",
        "identity"
      ],
      "keywords": [],
      "useCases": [
        "Prove possession of an issuer-signed credential without showing it",
        "Selective disclosure of verified attributes"
