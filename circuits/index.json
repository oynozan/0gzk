          "description": "EdDSA signature R point x"
        },
        "sigR8y": {
          "type": "field",
          "visibility": "private",
          "description": "EdDSA signature R point y"
        },
        "contextId": {
          "type": "field",
          "visibility": "public",
          "description": "Application / session identifier; namespaces the nullifier"
        }
      },
      "outputs": {
        "nullifier": {
          "type": "field",
          "description": "Poseidon(subject, contextId). Use to detect credential reuse"
        }
