        },
        "latMax": {
          "type": "uint",
          "visibility": "public",
          "description": "Inclusive maximum encoded latitude of the geofence"
        },
        "lngMin": {
          "type": "uint",
          "visibility": "public",
          "description": "Inclusive minimum encoded longitude of the geofence"
        },
        "lngMax": {
          "type": "uint",
          "visibility": "public",
