{
  "name": "0gzk",
  "version": "0.1.0",
  "private": true,
  "description": "ZK Proof-as-a-Service platform on 0G Storage",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "clean": "pnpm -r --filter \"./packages/*\" clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "rimraf": "^6.0.1",
    "snarkjs": "^0.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@0gzk/cli": "workspace:^"
  }
}
